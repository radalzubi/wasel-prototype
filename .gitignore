# ─────────────────────────────────────────
# WASEL — Monorepo .gitignore
# ─────────────────────────────────────────

# ── Secrets & environment variables ──────
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local
# Keep examples — they document required keys without real values
!.env.example
!**/.env.example

# ── Node / npm ────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Build output ──────────────────────────
dist/
build/
out/
.vite/

# ── TypeScript ────────────────────────────
*.tsbuildinfo

# ── iOS (Capacitor / Xcode) ───────────────
**/ios/App/Pods/
**/ios/App/build/
**/ios/App/*.xcworkspace/xcuserdata/
**/ios/App/*.xcodeproj/xcuserdata/
**/ios/App/*.xcodeproj/project.xcworkspace/xcuserdata/
**/ios/App/DerivedData/
**/*.xcuserstate
**/.xcode.env.local

# ── Android (Capacitor / Gradle) ──────────
**/android/.gradle/
**/android/app/build/
**/android/build/
**/android/local.properties
**/android/capacitor-cordova-android-plugins/
**/android/gradle/wrapper/gradle-wrapper.jar

# ── macOS ─────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# ── Editors & IDEs ───────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ── Internal / AI task prompt files ───────
tasks/

# ── Logs ──────────────────────────────────
logs/
*.log

# ── Test artefacts ────────────────────────
coverage/
.nyc_output/

# ── Native credentials (safety net) ───────
*.p12
*.p8
*.pem
*.mobileprovision
GoogleService-Info.plist
google-services.json
__pycache__/
.ipynb_checkpoints/
.agents/
