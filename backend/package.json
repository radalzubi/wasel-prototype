{
  "name": "@wasel/backend",
  "version": "0.1.0",
  "description": "Wasel platform backend — ride orchestration and dispatch",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
